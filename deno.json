{
  "name": "@dreamer/auth",
  "version": "1.1.0",
  "exports": {
    ".": "./src/mod.ts",
    "./jwt": "./src/jwt.ts",
    "./session": "./src/session.ts",
    "./oauth": "./src/oauth.ts",
    "./refresh": "./src/refresh.ts"
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/crypto": "jsr:@dreamer/crypto@^1.1.0",
    "@dreamer/session": "jsr:@dreamer/session@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2"
  },
  "tasks": {
    "test": "deno test --allow-all tests/*.test.ts",
    "test:node": "tsx --tsconfig tsconfig.json --test --test-force-exit tests/*.test.ts",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/ tests/",
    "fmt": "deno fmt src/ tests/"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "deno.json",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "exclude": [
      "tests/**",
      "**/*.test.ts"
    ]
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0
}
